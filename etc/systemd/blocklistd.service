[Unit]
Description=blocklistd - dynamic packet-filter bans from daemon notifications
Documentation=https://github.com/derekm/blocklist/blob/linux-port/LINUX.md
After=network-pre.target nftables.service blocklistd.socket
Wants=nftables.service
Requires=blocklistd.socket
Before=ssh.service racoon2.target iked.service

[Service]
Type=simple
# -d stays in the foreground (no daemon(0,0)/pidfile). Required for Type=simple.
# blocklistd.socket hands the SOCK_DGRAM AF_UNIX fd via LISTEN_FDS;
# bl_create() takes it and skips the connect-probe/bind.
RuntimeDirectory=blocklistd
RuntimeDirectoryMode=0755
# blocklistd.socket owns /run/blocklistd/blocklistd.sock; without this a
# service stop/restart removes the directory and the socket path with it.
RuntimeDirectoryPreserve=yes
StateDirectory=blocklistd
StateDirectoryMode=0750
ExecStartPre=/bin/sh -c 'command -v nft >/dev/null && nft list table inet blocklistd >/dev/null 2>&1 || nft -f /usr/share/examples/blocklistd.nft || true'
ExecStart=/usr/sbin/blocklistd -d -r -s /run/blocklistd/blocklistd.sock -D /var/lib/blocklistd/blocklistd.db
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/blocklistd /run/blocklistd
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
Also=blocklistd.socket

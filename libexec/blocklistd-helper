#!/bin/sh
#echo "run $@" 1>&2
#set -x
# $1 command
# $2 rulename
# $3 protocol
# $4 address
# $5 mask
# $6 port
# $7 id

# Optional override: BLOCKLIST_PF=nft|iptables|npf|pf|ipfw|ipfilter
# or /etc/blocklistd-pf containing one of those names.
# Linux default is nftables sets (see LINUX.md). iptables is the compat path.

pf=${BLOCKLIST_PF:-}
if [ -z "$pf" ] && [ -f /etc/blocklistd-pf ]; then
	pf=$(tr -d ' \t\n' < /etc/blocklistd-pf)
fi

if [ -f "/etc/ipfw-blocklist.rc" ]; then
	pf="ipfw"
	. /etc/ipfw-blocklist.rc
	ipfw_offset=${ipfw_offset:-2000}
fi

if [ -z "$pf" ]; then
	for f in npf pf ipfilter ipfw; do
		if [ -x /etc/rc.d/$f ]; then
			if /etc/rc.d/$f status >/dev/null 2>&1; then
				pf="$f"
				break
			fi
		elif [ -f "/etc/$f.conf" ]; then
			pf="$f"
			break
		fi
	done
fi

nftcmd=
for c in /usr/sbin/nft /sbin/nft nft; do
	if command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; then
		nftcmd=$(command -v "$c" 2>/dev/null || echo "$c")
		break
	fi
done
if [ -z "$pf" ] && [ -n "$nftcmd" ]; then
	pf="nft"
fi
if [ -z "$pf" ] && [ -x "/sbin/iptables" ]; then
	pf="iptables"
fi

if [ -z "$pf" ]; then
	echo "$0: Unsupported packet filter" 1>&2
	exit 1
fi

flags=
if [ -n "$3" ]; then
	raw_proto="$3"
	proto="proto $3"
	if [ $3 = "tcp" ]; then
		flags="flags S/SAFR"
	fi
fi

if [ -n "$6" ]; then
	raw_port="$6"
	port="port $6"
fi

addr="$4"
mask="$5"
case "$4" in
::ffff:*.*.*.*)
	if [ "$5" = 128 ]; then
		mask=32
		addr=${4#::ffff:}
	fi;;
esac

nft_elem()
{
	elem="$addr"
	if [ -n "$mask" ] && [ "$mask" != 32 ] && [ "$mask" != 128 ]; then
		elem="$addr/$mask"
	fi
	set=banned4
	case "$addr" in
	*:*) set=banned6 ;;
	esac
	if [ -z "$nftcmd" ]; then
		nftcmd=nft
	fi
}

case "$1" in
add)
	case "$pf" in
	ipfilter)
		echo block in log quick $proto \
		    from $addr/$mask to any $flags group $2 | \
		    /sbin/ipf -A -f - >/dev/null 2>&1 && echo OK
		;;
	ipfw)
		rule=$(($ipfw_offset + $6))
		tname="port$6"
		/sbin/ipfw table $tname create type addr 2>/dev/null
		/sbin/ipfw -q table $tname add "$addr/$mask"
		/sbin/ipfw show $rule >/dev/null 2>&1 || \
			/sbin/ipfw add $rule drop $3 from \
			table"("$tname")" to any dst-port $6 >/dev/null && \
			echo OK
		;;
	nft)
		nft_elem
		$nftcmd list table inet blocklistd >/dev/null 2>&1 || \
			$nftcmd -f /usr/share/examples/blocklistd/blocklistd.nft \
			2>/dev/null || true
		$nftcmd add element inet blocklistd "$set" "{ $elem }" && echo OK
		;;
	iptables)
		if ! /sbin/iptables --list "$2" >/dev/null 2>&1; then
			/sbin/iptables --new-chain "$2"
		fi
		/sbin/iptables --append INPUT --proto "$raw_proto" \
		    --dport "$raw_port" --jump "$2"
		/sbin/iptables --append "$2" --proto "$raw_proto" \
		    --source "$addr/$mask" --dport "$raw_port" --jump DROP
		echo OK
		;;
	npf)
		/sbin/npfctl rule "$2" add block in final $proto from \
		    "$addr/$mask" to any $port
		;;
	pf)
		/sbin/pfctl -a "$2/$6" -sr 2>/dev/null | \
		    grep -q "<port$6>" || \
		    echo "block in quick $proto from <port$6> to any $port" | \
		    /sbin/pfctl -a "$2/$6" -f -
		/sbin/pfctl -qa "$2/$6" -t "port$6" -T add "$addr/$mask" && \
		    /sbin/pfctl -qk "$addr" && echo OK
		;;
	esac
	;;
rem)
	case "$pf" in
	ipfilter)
		echo block in log quick $proto \
		    from $addr/$mask to any $flags group $2 | \
		    /sbin/ipf -A -r -f - >/dev/null 2>&1 && echo OK
		;;
	ipfw)
		/sbin/ipfw table "port$6" delete "$addr/$mask" 2>/dev/null && echo OK
		;;
	nft)
		nft_elem
		$nftcmd delete element inet blocklistd "$set" "{ $elem }" 2>/dev/null
		echo OK
		;;
	iptables)
		if /sbin/iptables --list "$2" >/dev/null 2>&1; then
			/sbin/iptables --delete "$2" --proto "$raw_proto" \
			    --source "$addr/$mask" --dport "$raw_port" \
			    --jump DROP
		fi
		echo OK
		;;
	npf)
		/sbin/npfctl rule "$2" rem-id "$7"
		;;
	pf)
		/sbin/pfctl -qa "$2/$6" -t "port$6" -T delete "$addr/$mask" && echo OK
		;;
	esac
	;;
flush)
	case "$pf" in
	ipfilter)
		/sbin/ipf -I -F a
		/usr/sbin/ipfstat -io | fgrep -v "group $2" | \
		    /sbin/ipf -I -f - >/dev/null 2>&1
		/sbin/ipf -s && echo OK
		;;
	ipfw)
		/sbin/ipfw table "port$6" flush 2>/dev/null && echo OK
		;;
	nft)
		if [ -z "$nftcmd" ]; then
			nftcmd=nft
		fi
		$nftcmd flush set inet blocklistd banned4 2>/dev/null || true
		$nftcmd flush set inet blocklistd banned6 2>/dev/null || true
		echo OK
		;;
	iptables)
		if /sbin/iptables --list "$2" >/dev/null 2>&1; then
			/sbin/iptables --flush "$2"
		fi
		echo OK
		;;
	npf)
		/sbin/npfctl rule "$2" flush
		;;
	pf)
		for anchor in $(/sbin/pfctl -a "$2" -s Anchors 2> /dev/null); do
			/sbin/pfctl -a "$anchor" -t "port${anchor##*/}" -T flush
			/sbin/pfctl -a "$anchor" -F rules
		done
		echo OK
		;;
	esac
	;;
*)
	echo "$0: Unknown command '$1'" 1>&2
	exit 1
	;;
esac

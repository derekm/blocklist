--- a/iked/configure.ac
+++ b/iked/configure.ac
@@ -0,0 +1,8 @@
+AC_ARG_ENABLE(blocklist,
+	[AS_HELP_STRING([--enable-blocklist],
+		[notify blocklistd of IKE scanners / AUTH failures])],
+	[], [enable_blocklist=no])
+AS_IF([test "x$enable_blocklist" = xyes],

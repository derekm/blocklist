@@ -667,6 +667,8 @@
 	if (info->result == VERIFIED_FAILURE) {
 		isakmp_log(ike_sa, info->local, info->remote, info->packet,
 			   PLOG_PROTOERR, PLOGLOC, "authentication failure\n");
